# Copy this file to .env.local and fill in real values.
# Business details (name, phone, GA4 ID, domain, ...) live in src/config/site.ts, not here.

# Resend API key for sending quote-form lead emails (https://resend.com)
RESEND_API_KEY=

# Address that receives new lead notifications
LEAD_NOTIFY_EMAIL=

# Verified sender address in Resend, e.g. "Website Leads <leads@yourdomain.com>"
LEAD_FROM_EMAIL=
